options {
    directory "/var/cache/bind";
    listen-on { 10.0.0.1; };
};

# I really advice comment all of the logging because it will give a lot of errors later on named.
# I will leave for advance users.
logging {
    channel default_log {
        file "/var/log/named/named.log";
        severity info;
        print-time yes;
    };
    category default {
        default_log;
    };
    category queries {
        default_log;
    };
};
